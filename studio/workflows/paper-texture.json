{
	"1": {
		"class_type": "UNETLoader",
		"_meta": { "title": "flux-2-klein-4b-fp8" },
		"inputs": {
			"unet_name": "__MODEL__",
			"weight_dtype": "default"
		}
	},
	"2": {
		"class_type": "CLIPLoader",
		"_meta": { "title": "qwen3 text encoder (flux2)" },
		"inputs": {
			"clip_name": "__CLIP__",
			"type": "flux2",
			"device": "default"
		}
	},
	"3": {
		"class_type": "VAELoader",
		"_meta": { "title": "flux2 vae" },
		"inputs": {
			"vae_name": "__VAE__"
		}
	},
	"4": {
		"class_type": "CLIPTextEncode",
		"_meta": { "title": "positive" },
		"inputs": {
			"text": "__POSITIVE__",
			"clip": ["2", 0]
		}
	},
	"5": {
		"class_type": "CLIPTextEncode",
		"_meta": { "title": "negative (archived only at cfg=1)" },
		"inputs": {
			"text": "__NEGATIVE__",
			"clip": ["2", 0]
		}
	},
	"6": {
		"class_type": "EmptyFlux2LatentImage",
		"_meta": { "title": "empty latent" },
		"inputs": {
			"width": "__WIDTH__",
			"height": "__HEIGHT__",
			"batch_size": 1
		}
	},
	"7": {
		"class_type": "Flux2Scheduler",
		"_meta": { "title": "sigmas" },
		"inputs": {
			"steps": "__STEPS__",
			"width": "__WIDTH__",
			"height": "__HEIGHT__"
		}
	},
	"8": {
		"class_type": "KSamplerSelect",
		"_meta": { "title": "sampler" },
		"inputs": {
			"sampler_name": "__SAMPLER__"
		}
	},
	"9": {
		"class_type": "CFGGuider",
		"_meta": { "title": "cfg" },
		"inputs": {
			"model": ["1", 0],
			"positive": ["4", 0],
			"negative": ["5", 0],
			"cfg": "__CFG__"
		}
	},
	"10": {
		"class_type": "RandomNoise",
		"_meta": { "title": "seed" },
		"inputs": {
			"noise_seed": "__SEED__"
		}
	},
	"11": {
		"class_type": "SamplerCustomAdvanced",
		"_meta": { "title": "sample" },
		"inputs": {
			"noise": ["10", 0],
			"guider": ["9", 0],
			"sampler": ["8", 0],
			"sigmas": ["7", 0],
			"latent_image": ["6", 0]
		}
	},
	"12": {
		"class_type": "VAEDecode",
		"_meta": { "title": "decode" },
		"inputs": {
			"samples": ["11", 0],
			"vae": ["3", 0]
		}
	},
	"13": {
		"class_type": "SaveImage",
		"_meta": { "title": "save" },
		"inputs": {
			"filename_prefix": "__PREFIX__",
			"images": ["12", 0]
		}
	}
}
