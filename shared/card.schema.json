{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Solstice card game · card pack manifest",
  "description": "卡牌内容包 manifest 唯一真源（继承 Solstice 声明式包思想）。生产者：studio 管线/手工 JSON；消费者：src/core/cards。改这里必须同步 docs/DESIGN.md §2。",
  "type": "object",
  "required": ["id", "api", "name", "cards"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^cardpack\\.[a-z0-9]+(\\.[a-z0-9]+)*$" },
    "api": { "type": "integer", "const": 1 },
    "name": { "$ref": "#/definitions/i18n" },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "suit", "season", "rank", "image"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^card\\.[a-z0-9-]+(\\.[a-z0-9-]+)*$", "description": "card.<主题>.<阶>，全库唯一" },
          "name": { "$ref": "#/definitions/i18n" },
          "suit": { "enum": ["mountain", "water", "plant", "bird", "beast", "person", "sky", "artifact"] },
          "season": { "enum": ["spring", "summer", "autumn", "winter", "all"] },
          "rank": { "enum": [1, 2, 3], "description": "阶：合成链层级" },
          "image": { "type": "string", "description": "卡面画芯 PNG（studio 产出），引擎绘制统一边框/角饰/文字" },
          "combos": { "type": "array", "items": { "type": "string" }, "description": "参与的组合 id（定义见 combos.json）" },
          "flavor": { "$ref": "#/definitions/i18n" },
          "credits": { "type": "string", "description": "模型 | prompt 出处 | 日期（Steam AI 披露留档）" }
        }
      }
    },
    "credits": { "type": "string" }
  },
  "definitions": {
    "i18n": {
      "type": "object",
      "required": ["zh", "en"],
      "properties": { "zh": { "type": "string" }, "en": { "type": "string" } }
    }
  }
}
